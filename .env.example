# ---------------------------------------------------------------------------
# CyberCheck Admin Dashboard — configuration
#
# Nothing in the source tree hardcodes a hostname, token, business, or entity.
# Everything below is read at runtime through src/config/env.js.
# ---------------------------------------------------------------------------

# Base URL of the gcr-api-clean API. Leave blank to call the same origin the
# dashboard is served from (useful when it sits behind the same proxy/domain).
VITE_API_BASE_URL=https://gcr-api-clean.vercel.app

# localStorage key holding the admin JWT. Kept configurable so this app can
# share (or deliberately not share) a session with the legacy dashboard.
VITE_AUTH_TOKEN_KEY=cc_admin_token

# Role required to use the dashboard, checked against the JWT and the server.
VITE_REQUIRED_ROLE=admin

# Public GCR site, used to build claim and preview links on the Sales Pages
# screen. Leave blank if there isn't one — the screen says so rather than
# guessing a hostname.
VITE_PUBLIC_SITE_URL=

# Product/brand strings shown in the shell.
VITE_APP_NAME=CyberCheck Admin
VITE_APP_SHORT_NAME=CyberCheck

# Default page size for paginated lists.
VITE_DEFAULT_PAGE_SIZE=50

# Request timeout in milliseconds.
VITE_REQUEST_TIMEOUT_MS=45000

# Dev-only: proxy /api through the Vite dev server to a local API instance.
# VITE_DEV_API_PROXY=http://localhost:3000
