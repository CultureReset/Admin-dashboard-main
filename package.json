{
  "name": "cybercheck-admin-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CyberCheck admin dashboard — modular React rebuild, wired to the gcr-api-clean API.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "audit:endpoints": "node scripts/audit-endpoints.mjs",
    "sections:map": "node scripts/generate-section-map.mjs",
    "sections:check": "node scripts/generate-section-map.mjs --check",
    "verify": "npm run lint && npm run audit:endpoints && npm run sections:check && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
