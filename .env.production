# Production build configuration.
#
# Without VITE_API_BASE_URL the dashboard calls its own origin (see
# src/config/env.js), which the SPA rewrite answers with index.html — every
# screen then renders empty with no error. This file is the default so a
# production build is correct without anyone remembering to set it.
#
# A real environment variable set in the Vercel project overrides this file,
# so pointing a deployment somewhere else needs no code change.

VITE_API_BASE_URL=https://gcr-api-clean.vercel.app
VITE_AUTH_TOKEN_KEY=cc_admin_token
VITE_REQUIRED_ROLE=admin
VITE_APP_NAME=CyberCheck Admin
VITE_APP_SHORT_NAME=CyberCheck
VITE_DEFAULT_PAGE_SIZE=50
VITE_REQUEST_TIMEOUT_MS=45000
