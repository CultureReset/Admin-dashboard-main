{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/node",
      "destination": "https://steve-ms-7c02.tail1af4f2.ts.net:10000/"
    },
    {
      "source": "/node/",
      "destination": "https://steve-ms-7c02.tail1af4f2.ts.net:10000/"
    },
    {
      "source": "/node/:path*",
      "destination": "https://steve-ms-7c02.tail1af4f2.ts.net:10000/:path*"
    },
    {
      "source": "/((?!assets/|api/|node/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
